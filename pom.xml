<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.outsera</groupId>
    <artifactId>awards</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>awards</name>
    <description>API dos intervalos de premiação dos produtores do Golden Raspberry Awards</description>

    <properties>
        <java.version>25</java.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <!-- Mesma versão do Swagger UI que o springdoc 3.2.0 traria (research R8) -->
        <swagger-ui.version>5.35.1</swagger-ui.version>
        <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
        <jacoco.version>0.8.16</jacoco.version>
        <!-- Cobertura mínima de linhas dos testes de integração (spec 002, FR-028a). Medido: 97,06% no
             fim do Marco 1. Sobrescrevível na linha de comando, para provar que o portão funciona. -->
        <jacoco.line.minimum>0.90</jacoco.line.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Liveness, readiness e métricas (spec 002, FR-008 a FR-016; research R1) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Métricas no formato do Prometheus em /actuator/prometheus (research R3) -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <!-- Swagger UI sobre o contrato estático /openapi.yaml, sem gerar contrato pelo código
                 (FR-024, research R8). A página é static/swagger-ui.html. -->
            <groupId>org.webjars</groupId>
            <artifactId>swagger-ui</artifactId>
            <version>${swagger-ui.version}</version>
        </dependency>
        <dependency>
            <!-- Caminhos sem versão em /webjars/** (versão gerenciada pelo Boot) -->
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testes: somente de integração (*IT, Failsafe). Princípio I da constituição. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Sem mocks (Princípio I). Também elimina o aviso de agente dinâmico do Mockito. -->
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- RestTestClient e @AutoConfigureRestTestClient (Spring Boot 4) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Valida as respostas reais contra o openapi.yaml (FR-025, research R8) -->
            <groupId>com.atlassian.oai</groupId>
            <!-- Antigo swagger-request-validator-core, relocado pelo próprio projeto na versão 3.0.0 -->
            <artifactId>openapi-request-validator-core</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Vem do swagger-core e faria o Spring tentar montar um Bean Validation só nos
                     testes. O classpath de teste fica igual ao de produção. -->
                <exclusion>
                    <groupId>jakarta.validation</groupId>
                    <artifactId>jakarta.validation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- Os testes que verificam o log rodam de novo com o JSON ligado, numa JVM
                             própria: o Logback é global na JVM, e ligar o JSON num contexto mudaria o
                             formato dos testes seguintes (spec 002, FR-018; research R6). -->
                        <id>json-logs</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <groups>log</groups>
                            <environmentVariables>
                                <LOGGING_STRUCTURED_FORMAT_CONSOLE>ecs</LOGGING_STRUCTURED_FORMAT_CONSOLE>
                            </environmentVariables>
                            <reportsDirectory>${project.build.directory}/failsafe-reports-json-logs</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-reports-json-logs/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Cobertura medida sobre as duas execuções do Failsafe, com mínimo de linhas no verify,
                     também local, sem Docker (spec 002, FR-028a; research R7). Declarado depois do
                     Failsafe, para o check rodar depois do verify dele. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-it.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

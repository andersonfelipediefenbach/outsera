<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.outsera</groupId>
    <artifactId>awards</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>awards</name>
    <description>API dos intervalos de premiação dos produtores do Golden Raspberry Awards</description>

    <properties>
        <java.version>25</java.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <!-- Mesma versão do Swagger UI que o springdoc 3.2.0 traria (research R8) -->
        <swagger-ui.version>5.34.0</swagger-ui.version>
        <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- Cobertura mínima de linhas dos testes de integração (spec 002, FR-028a). Medido: 97,06% no
             fim do Marco 1. Sobrescrevível na linha de comando, para provar que o portão funciona. -->
        <jacoco.line.minimum>0.90</jacoco.line.minimum>
        <!-- O perfil postgres-it liga as duas propriedades abaixo: roda só os *PostgresIT e não aplica a
             cobertura mínima, que é a do ./mvnw verify padrão (spec 003, research R16). -->
        <it.default.skip>false</it.default.skip>
        <jacoco.check.skip>false</jacoco.check.skip>
        <!-- Dependências de runtime do kafka-clients 4.2.2, fora do BOM do Spring Boot 4.1.2. As versões
             trazidas por ele (lz4-java 1.11.2 e snappy-java 1.1.10.7) têm vulnerabilidades altas com
             correção, que reprovaram a porta da imagem no PR do Marco 3: CVE-2026-106451 no lz4-java e
             CVE-2026-108106 e CVE-2026-93451 no snappy-java. Fica a última correção da mesma linha.
             Retirar quando o kafka-clients trouxer versões corrigidas. -->
        <lz4-java.version>1.11.4</lz4-java.version>
        <snappy-java.version>1.1.10.12</snappy-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Liveness, readiness e métricas (spec 002, FR-008 a FR-016; research R1) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Métricas no formato do Prometheus em /actuator/prometheus (research R3) -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <!-- Autenticação por token, desligada sem API_TOKEN (spec 003, FR-019 a FR-026; research R11).
                 O usuário gerado pelo Boot fica excluído no application.yml. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!-- Ingestão por Kafka no perfil kafka (spec 003, FR-009 a FR-018). A autoconfiguração do Boot
                 fica excluída fora do perfil (research R2). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <!-- Swagger UI sobre o contrato estático /openapi.yaml, sem gerar contrato pelo código
                 (FR-024, research R8). A página é static/swagger-ui.html. -->
            <groupId>org.webjars</groupId>
            <artifactId>swagger-ui</artifactId>
            <version>${swagger-ui.version}</version>
        </dependency>
        <dependency>
            <!-- Caminhos sem versão em /webjars/** (versão gerenciada pelo Boot) -->
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Banco do perfil postgres (spec 003, FR-004; research R3). Só é usado com o perfil. -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Desde o Flyway 10, o suporte a cada banco fica num módulo próprio (research R3) -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testes: somente de integração (*IT, Failsafe). Princípio I da constituição. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Sem mocks (Princípio I). Também elimina o aviso de agente dinâmico do Mockito. -->
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <!-- RestTestClient e @AutoConfigureRestTestClient (Spring Boot 4) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Broker Kafka embutido (KRaft) nos testes, sem Docker (Princípio II; research R15) -->
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Valida as respostas reais contra o openapi.yaml (FR-025, research R8) -->
            <groupId>com.atlassian.oai</groupId>
            <!-- Antigo swagger-request-validator-core, relocado pelo próprio projeto na versão 3.0.0 -->
            <artifactId>openapi-request-validator-core</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
            <exclusions>
                <!-- Vem do swagger-core e faria o Spring tentar montar um Bean Validation só nos
                     testes. O classpath de teste fica igual ao de produção. -->
                <exclusion>
                    <groupId>jakarta.validation</groupId>
                    <artifactId>jakarta.validation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- Os testes que exigem PostgreSQL rodam só no perfil postgres-it, no pipeline
                         (spec 003, FR-007; Princípio VI, constituição 1.7.0; research R16). -->
                    <excludes>
                        <exclude>**/*PostgresIT.java</exclude>
                    </excludes>
                    <skip>${it.default.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- Os testes que verificam o log rodam de novo com o JSON ligado, numa JVM
                             própria: o Logback é global na JVM, e ligar o JSON num contexto mudaria o
                             formato dos testes seguintes (spec 002, FR-018; research R6). -->
                        <id>json-logs</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <groups>log</groups>
                            <environmentVariables>
                                <LOGGING_STRUCTURED_FORMAT_CONSOLE>ecs</LOGGING_STRUCTURED_FORMAT_CONSOLE>
                            </environmentVariables>
                            <reportsDirectory>${project.build.directory}/failsafe-reports-json-logs</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-reports-json-logs/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Cobertura medida sobre as duas execuções do Failsafe, com mínimo de linhas no verify,
                     também local, sem Docker (spec 002, FR-028a; research R7). Declarado depois do
                     Failsafe, para o check rodar depois do verify dele. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-integration</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${jacoco.check.skip}</skip>
                            <dataFile>${project.build.directory}/jacoco-it.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- ./mvnw -Ppostgres-it verify: só os *PostgresIT, contra o PostgreSQL de DB_URL, DB_USER e
                 DB_PASSWORD. Executado obrigatoriamente pelo job postgres do pipeline (spec 003, FR-007;
                 Princípio VI, constituição 1.7.0; research R16). Sem paralelismo do JUnit: o
                 RetryPostgresIT não pode rodar ao mesmo tempo que outro IT. -->
            <id>postgres-it</id>
            <properties>
                <it.default.skip>true</it.default.skip>
                <jacoco.check.skip>true</jacoco.check.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>postgres</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <skip>false</skip>
                                    <includes>
                                        <include>**/*PostgresIT.java</include>
                                    </includes>
                                    <excludes combine.self="override"/>
                                    <reportsDirectory>${project.build.directory}/failsafe-reports-postgres</reportsDirectory>
                                    <summaryFile>${project.build.directory}/failsafe-reports-postgres/failsafe-summary.xml</summaryFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
